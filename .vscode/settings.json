{
  "files.associations": {
    "*.njk": "nunjucks",
    "*.nj": "nunjucks"
  },
  "terminal.integrated.env.linux": {
    "DEBUG_PKG": "1",
    "ESLINT_USE_FLAT_CONFIG": "true",
    "NUITKA_CACHE_DIR": "${workspaceFolder}/tmp/nuitka-cache",
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/usr/lib/wsl/lib:${workspaceFolder}/node_modules/.bin:${workspaceFolder}/bin:${workspaceFolder}/vendor/bin:${workspaceFolder}/.venv/bin:${workspaceFolder}/venv/bin:$PATH",
    "PHP_CS_FIXER_IGNORE_ENV": "1",
    "PUPPETEER_SKIP_DOWNLOAD": "true",
    "WORKSPACE_FOLDER": "${workspaceFolder}"
  },
  "terminal.integrated.env.windows": {
    "DEBUG_PKG": "1",
    "ESLINT_USE_FLAT_CONFIG": "true",
    "NUITKA_CACHE_DIR": "${workspaceFolder}\\tmp\\nuitka-cache",
    "PATH": "${env:LOCALAPPDATA}\\nvm;C:\\nvm4w\\nodejs;C:\\Program Files\\Git\\cmd;C:\\Program Files\\Git\\usr\\bin;${workspaceFolder}\\node_modules\\.bin;${workspaceFolder}\\bin;${workspaceFolder}\\vendor\\bin;C:\\laragon\\bin\\mysql\\mysql-8.4.3-winx64\\bin;${env:LOCALAPPDATA}\\Programs\\Ollama;${workspaceFolder}\\venv\\Scripts;${workspaceFolder}\\.venv\\Scripts;${env:PATH};",
    "PHP_CS_FIXER_IGNORE_ENV": "1",
    "PUPPETEER_SKIP_DOWNLOAD": "true",
    "WORKSPACE_FOLDER": "${workspaceFolder}"
  },
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": ["${env:windir}\\Sysnative\\cmd.exe", "${env:windir}\\System32\\cmd.exe"],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash"
    },
    "Cygwin": {
      "path": "C:\\cygwin64\\bin\\bash.exe",
      "args": ["--login", "-i"],
      "env": {
        "CHERE_INVOKING": "1"
      }
    },
    "Short PowerShell": {
      "source": "PowerShell",
      "args": ["-NoExit", "-Command", "function prompt { \"[$((Get-Item .).Name)]> \" }"],
      "icon": "terminal-powershell"
    },
    "Short Command Prompt": {
      "path": ["${env:windir}\\System32\\cmd.exe"],
      "args": ["/k", "prompt $p$_$g"],
      "icon": "terminal-cmd"
    },
    "PowerShell 7": {
      "path": "${env:LOCALAPPDATA}\\Microsoft\\WindowsApps\\pwsh.exe",
      "icon": "terminal-powershell"
    },
    "Short PowerShell 7": {
      "path": "${env:LOCALAPPDATA}\\Microsoft\\WindowsApps\\pwsh.exe",
      "args": [
        "-NoExit",
        "-Command",
        "function prompt { Write-Host '[' -NoNewline -ForegroundColor DarkGray; Write-Host (Split-Path -Leaf (Get-Location)) -NoNewline -ForegroundColor Cyan; Write-Host ']> ' -NoNewline -ForegroundColor DarkGray; return ' ' }"
      ],
      "icon": "terminal-powershell"
    },
    "Oh My Posh": {
      "path": "${env:LOCALAPPDATA}\\Microsoft\\WindowsApps\\pwsh.exe",
      "args": [
        "-NoExit",
        "-Command",
        "$init = $null; foreach ($candidate in @('${workspaceFolder}/scripts/OhMyPoshInit.ps1','${workspaceFolder}/node_modules/@dimaslanjaka/eslint-base-config/scripts/OhMyPoshInit.ps1')) { if (Test-Path $candidate) { $init = $candidate; break } }; if ($init) { & $init } else { oh-my-posh init pwsh | Invoke-Expression }"
      ],
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.windows": "Short PowerShell",
  "npm.enableRunFromFolder": true,
  "files.autoSave": "onWindowChange",
  "files.autoSaveDelay": 30000,
  "editor.fontFamily": "Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "js/ts.tsc.autoDetect": "on",
  "emmet.includeLanguages": {
    "ejs": "html",
    "njk": "html",
    "nunjucks": "html"
  },
  "emmet.syntaxProfiles": {
    "njk": "html"
  },
  "eslint.debug": true,
  "eslint.useFlatConfig": true,
  "eslint.format.enable": true,
  "eslint.trace.server": "messages",
  "editor.wordWrap": "on",
  "editor.bracketPairColorization.enabled": true,
  "js/ts.suggestionActions.enabled": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.fixAll": "never",
    "source.fixAll.eslint": "explicit",
    "source.fixAll.ts": "never",
    "source.addMissingImports.ts": "never",
    "source.removeUnused.ts": "never",
    "source.removeUnusedImports": "never",
    "source.sort.json": "never",
    "source.sortImports": "never"
  },
  "eslint.validate": [
    "javascript",
    "typescript",
    "astro",
    "civet",
    "javascriptreact",
    "typescriptreact",
    "html",
    "mdx",
    "vue",
    "markdown",
    "json",
    "jsonc",
    "css",
    "glimmer-js",
    "glimmer-ts",
    "svelte",
    "nunjucks"
  ],
  "[nunjucks]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "monosans.djlint",
    "editor.suggest.insertMode": "replace",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll": "never"
    }
  },
  "[njk]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.suggest.insertMode": "replace",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll": "never"
    }
  },
  "[ejs]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "editor.formatOnSave": false,
  "editor.tabSize": 2,
  "files.eol": "\n",
  "code-runner.executorMap": {
    "typescriptreact": "node --no-warnings --experimental-specifier-resolution=node --loader ts-node/esm -r dotenv/config --expose-gc",
    "javascript": "node --expose-gc --require dotenv/config",
    "typescript": "node --no-warnings --experimental-specifier-resolution=node --loader ts-node/esm -r dotenv/config"
  },
  "code-runner.runInTerminal": true,
  "code-runner.cwd": "${workspaceFolder}",
  "code-runner.saveAllFilesBeforeRun": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.respectShebang": true,
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "js/ts.tsserver.tracing.enabled": false,
  "js/ts.tsserver.log": "off",
  "editor.autoClosingBrackets": "always",
  "editor.matchBrackets": "always",
  "prettier.enableDebugLogs": true,
  "prettier.prettierPath": "./node_modules/prettier",
  "prettier.printWidth": 180,
  "npm.packageManager": "yarn",
  "git.enabled": true,
  "explorer.autoReveal": true,
  "git.autofetch": "all",
  "git.autorefresh": true,
  "git.autoStash": true,
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": "file:///d%3A/Repositories/static-blog-generator/.github/workflows/test-beta.yml",
    "https://json.schemastore.org/dependabot-2.0.json": "file:///d%3A/Repositories/static-blog-generator/.github/dependabot.yml"
  },
  "auto-rename-tag.activationOnLanguage": [
    "html",
    "xml",
    "php",
    "javascript",
    "nunjucks",
    "typescriptreact",
    "javascriptreact"
  ],
  "git.useCommitInputAsStashMessage": true,
  "eslint.probe": [
    "astro",
    "civet",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html",
    "mdx",
    "vue",
    "markdown",
    "json",
    "jsonc",
    "css",
    "glimmer-js",
    "glimmer-ts",
    "svelte",
    "nunjucks"
  ],
  "scss.format.enable": false,
  "scss.lint.argumentsInColorFunction": "ignore",
  "css.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore"
}
