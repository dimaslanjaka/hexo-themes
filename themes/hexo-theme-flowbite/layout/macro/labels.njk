<span class="flex flex-wrap items-center mb-2 text-sm text-gray-600 dark:text-gray-400">
  {%- if post.categories and post.categories.length %}
    <i class="far fa-folder mr-1"></i>
    {%- for cat in post.categories.toArray() %}
      <span itemprop="about" itemscope itemtype="http://schema.org/Thing" class="min-w-0">
        <a href="{{ urlFor(cat.path) }}"
           itemprop="url"
           rel="index"
           class="ml-1 text-blue-600 dark:text-blue-400 hover:underline break-words">
          <span itemprop="name">{{ cat.name }}</span>
        </a>
        {%- if loop.index < post.categories.length %},{% endif %}
      </span>
    {%- endfor %}
  {%- endif %}
  {%- if post.tags and post.tags.length %}
    <!-- Added 'flex-wrap' here so tags wrap among themselves if needed -->
    <span class="flex items-center flex-wrap">
      <i class="far fa-tags mr-1"></i>
      {%- for tag in post.tags.toArray() %}
        <span itemprop="keywords" itemscope itemtype="http://schema.org/Thing" class="min-w-0">
          <a href="{{ urlFor(tag.path) }}"
             itemprop="url"
             rel="index"
             class="ml-1 text-blue-600 dark:text-blue-400 hover:underline break-words">
            <span itemprop="name">{{ tag.name }}</span>
          </a>
          {%- if loop.index < post.tags.length %},{% endif %}
        </span>
      {%- endfor %}
    </span>
  {%- endif %}
</span>
